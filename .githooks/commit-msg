#!/bin/sh
# Conventional Commits, as this repository started out (feat, fix, docs, chore, …) and then drifted away from.
# The first line: type(optional scope)!: summary. Merges, reverts and fixups pass.
first=$(head -n 1 "$1")
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit message does not follow Conventional Commits:" >&2
  echo "  $first" >&2
  echo "expected: type(scope): summary   e.g. feat(playground): pointer lock, fix(rt): counters overflow, docs: handoff" >&2
  echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
